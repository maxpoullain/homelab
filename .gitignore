**/7seas/prowlarr/Definitions/*
!**/7seas/prowlarr/Definitions/Custom/
**/7seas/radarr/
**/7seas/seerr/
**/7seas/sonarr/
**/7seas/transmission/
**/admin/arcane/
**/admin/beszel/
**/adsb/ultrafeeder/
**/docs/bookstack/
**/docs/papra/
**/front/crowdsec/*
!**/front/crowdsec/config/
**/front/crowdsec/config/*
!**/front/crowdsec/config/acquis.yaml
!**/front/crowdsec/config/profiles.yaml
!**/front/crowdsec/config/notifications/
**/front/crowdsec/config/notifications/*
!**/front/crowdsec/config/notifications/ha.yaml
**/front/tinyauth/*
!**/front/tinyauth/resources/
**/front/traefik/acme/
**/front/traefik/logs/
**/home/ha/
**/home/mosquitto/*
!**/home/mosquitto/config/
**/home/zigbee2mqtt/
**/media/immich/
**/media/jellyfin/
**/misc/filebrowser/
**/misc/homelable/
**/misc/octoprint/
**/misc/trek/
**/network/adguard/
**/network/tailscale/
tooling/data/backups/*.log*
**/vault/vaultwarden/

# ── Secrets: plaintext ignored, SOPS-encrypted (encrypted.*) tracked ──
# Keep this block LAST so no rule above can override the whitelist.
*.env
**/front/traefik/config/security/middlewares.yml
!encrypted.*
